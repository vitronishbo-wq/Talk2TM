rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == 'vitronis.hbo@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    // Fotografia única opcional de perfil Dating (WebP comprimido no cliente <= 150 KB)
    match /datingPhotos/{uid}/{fileName} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isSignedIn() &&
                      request.auth.uid == uid &&
                      fileName == 'avatar.webp' &&
                      request.resource != null &&
                      request.resource.size <= 150 * 1024 &&
                      request.resource.contentType == 'image/webp';
      allow delete: if isSignedIn() &&
                       fileName == 'avatar.webp' &&
                       (request.auth.uid == uid || isAdmin());
    }

    // Bloqueio por defeito em qualquer outro caminho
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
