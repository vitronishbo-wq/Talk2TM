rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isParticipant(roomId) {
      let room = get(/databases/$(database)/documents/rooms/$(roomId)).data;
      return request.auth != null && 
            (request.auth.uid == room.participantA || request.auth.uid == room.participantB);
    }

    match /rooms/{roomId} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow create: if isParticipant(request.resource.data.room);
      allow read: if isParticipant(resource.data.room);
      allow update, delete: if false;
    }
  }
}
