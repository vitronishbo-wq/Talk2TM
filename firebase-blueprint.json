{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "Sala textual legado com limite rígido de exatamente 2 participantes simultâneos.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "description": "Identificador da sala alfanumérico e hífens.",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_-]{1,32}$"
        },
        "participantA": {
          "type": "string",
          "description": "Identificador único (UUID) do primeiro participante.",
          "minLength": 1,
          "maxLength": 64
        },
        "participantB": {
          "type": "string",
          "description": "Identificador único (UUID) do segundo participante, vazio se não ocupado.",
          "maxLength": 64
        },
        "participantAName": {
          "type": "string",
          "description": "Nome de exibição sanitizado do participante A.",
          "minLength": 1,
          "maxLength": 30
        },
        "participantBName": {
          "type": "string",
          "description": "Nome de exibição sanitizado do participante B.",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora ISO de criação da sala."
        },
        "lastActivity": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora ISO da última atividade da sala."
        },
        "lastRead": {
          "type": "object",
          "description": "Mapeamento dos timestamps ISO da última leitura por participante."
        },
        "lastReadA": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp ISO da última leitura do participante A."
        },
        "lastReadB": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp ISO da última leitura do participante B."
        }
      },
      "required": ["roomId", "participantA", "participantAName", "createdAt", "lastActivity"]
    },
    "Message": {
      "title": "Message",
      "description": "Mensagem puramente textual para registro de chat 2P com idempotência por clientId.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Chave única composta para idempotência.",
          "minLength": 1,
          "maxLength": 128
        },
        "room": {
          "type": "string",
          "description": "Identificador da sala correspondente.",
          "minLength": 1,
          "maxLength": 32
        },
        "sender": {
          "type": "string",
          "description": "Nome textual sanitizado do remetente.",
          "minLength": 1,
          "maxLength": 30
        },
        "senderId": {
          "type": "string",
          "description": "Identificador único (UUID) do remetente.",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "description": "Texto puro da mensagem sem tags HTML nem rich media.",
          "minLength": 1,
          "maxLength": 2000
        },
        "clientId": {
          "type": "string",
          "description": "Identificador idempotente do lado do cliente.",
          "minLength": 1,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data/hora ISO de criação da mensagem."
        },
        "status": {
          "type": "string",
          "description": "Estado de entrega textual da mensagem.",
          "enum": ["pending", "synced", "failed", "read"]
        }
      },
      "required": ["messageId", "room", "sender", "senderId", "text", "clientId", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Conta privada vinculada ao UID do Firebase Auth.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID do Firebase Auth."
        },
        "talk2tmId": {
          "type": "string",
          "description": "Identificador público formatado TM-XXXX-XXXX.",
          "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "username": {
          "type": "string",
          "description": "Nome de utilizador único (ex: Truman01).",
          "minLength": 3,
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "talk2tmId", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Índice público de descoberta por Talk2TM ID.",
      "type": "object",
      "properties": {
        "talk2tmId": {
          "type": "string",
          "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "uid": {
          "type": "string"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["talk2tmId", "uid", "displayName", "active", "createdAt"]
    },
    "UsernameDirectoryEntry": {
      "title": "UsernameDirectoryEntry",
      "description": "Índice único por username em minúsculas para garantir unicidade sem expor listagem.",
      "type": "object",
      "properties": {
        "usernameLower": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9._]{3,30}$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "talk2tmId": {
          "type": "string",
          "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["usernameLower", "username", "uid", "talk2tmId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Conversa 1:1 bilateral entre dois UIDs autorizados.",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string"
        },
        "participantA": {
          "type": "string"
        },
        "participantB": {
          "type": "string"
        },
        "talk2tmIdA": {
          "type": "string"
        },
        "talk2tmIdB": {
          "type": "string"
        },
        "displayNameA": {
          "type": "string"
        },
        "displayNameB": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastReadA": {
          "type": "string",
          "format": "date-time"
        },
        "lastReadB": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "conversationId", "participantA", "participantB",
        "talk2tmIdA", "talk2tmIdB", "displayNameA", "displayNameB",
        "createdAt", "updatedAt"
      ]
    },
    "ConversationInvite": {
      "title": "ConversationInvite",
      "description": "Convite de conversa bilateral para formação de conexão 1:1.",
      "type": "object",
      "properties": {
        "inviteId": {
          "type": "string"
        },
        "fromUid": {
          "type": "string"
        },
        "fromDisplayName": {
          "type": "string"
        },
        "fromTalk2tmId": {
          "type": "string"
        },
        "toTalk2tmId": {
          "type": "string"
        },
        "toUid": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inviteId", "fromUid", "fromDisplayName", "fromTalk2tmId",
        "toTalk2tmId", "toUid", "conversationId", "status",
        "createdAt", "updatedAt"
      ]
    },
    "ConversationMessage": {
      "title": "ConversationMessage",
      "description": "Mensagem textual dentro de uma conversation específica.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string"
        },
        "conversationId": {
          "type": "string"
        },
        "senderId": {
          "type": "string"
        },
        "senderTalk2tmId": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "clientId": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "synced", "failed", "read"]
        }
      },
      "required": ["messageId", "conversationId", "senderId", "senderTalk2tmId", "text", "clientId", "createdAt"]
    },
    "DatingProfile": {
      "title": "DatingProfile",
      "description": "Perfil público adulto (+18) para descoberta finita no Talk2TM Dating, sem exposição de telefone ou e-mail.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "talk2tmId": { "type": "string", "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 30 },
        "age": { "type": "integer" },
        "gender": { "type": "string", "enum": ["woman", "man", "non_binary"] },
        "seeking": { "type": "string", "enum": ["women", "men", "all"] },
        "countryCode": { "type": "string", "minLength": 2, "maxLength": 2, "pattern": "^[A-Z]{2}$" },
        "city": { "type": "string", "minLength": 1, "maxLength": 60 },
        "cityKey": { "type": "string", "minLength": 1, "maxLength": 60 },
        "bio": { "type": "string", "minLength": 1, "maxLength": 160 },
        "intent": { "type": "string", "enum": ["serious", "meet_people", "chat"] },
        "adultConfirmed": { "type": "boolean" },
        "termsAcceptedAt": { "type": "string", "format": "date-time" },
        "termsVersion": { "type": "string", "minLength": 1, "maxLength": 20 },
        "discoverable": { "type": "boolean" },
        "paused": { "type": "boolean" },
        "suspended": { "type": "boolean" },
        "photoUrl": { "type": ["string", "null"], "maxLength": 600 },
        "photoPath": { "type": ["string", "null"], "maxLength": 200 },
        "photoStatus": { "type": "string", "enum": ["none", "pending", "approved", "rejected"] },
        "photoUpdatedAt": { "type": ["string", "null"], "format": "date-time" },
        "photoModerationNote": { "type": ["string", "null"], "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "talk2tmId", "displayName", "age", "gender", "seeking",
        "countryCode", "city", "cityKey", "bio", "intent",
        "adultConfirmed", "termsAcceptedAt", "termsVersion",
        "discoverable", "paused", "suspended", "createdAt", "updatedAt"
      ]
    },
    "DatingEvaluation": {
      "title": "DatingEvaluation",
      "description": "Registo privado de perfis avaliados ou bloqueados para exclusão na descoberta diária.",
      "type": "object",
      "properties": {
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "decision": { "type": "string", "enum": ["seen", "pass", "like", "blocked"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "dayKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      },
      "required": ["targetUid", "decision", "createdAt", "dayKey"]
    },
    "DatingLike": {
      "title": "DatingLike",
      "description": "Interesse secreto unilateral (Like) visível apenas ao remetente até reciprocidade.",
      "type": "object",
      "properties": {
        "likeId": { "type": "string", "minLength": 3, "maxLength": 260, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fromUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "toUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fromTalk2tmId": { "type": "string", "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "fromDisplayName": { "type": "string", "minLength": 1, "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["likeId", "fromUid", "toUid", "fromTalk2tmId", "fromDisplayName", "createdAt"]
    },
    "DatingMatch": {
      "title": "DatingMatch",
      "description": "Match exclusivamente recíproco entre dois perfis adultos com ligação automática a conversa 1:1.",
      "type": "object",
      "properties": {
        "matchId": { "type": "string", "minLength": 7, "maxLength": 266, "pattern": "^match_[a-zA-Z0-9_\\-]+$" },
        "conversationId": { "type": "string", "minLength": 6, "maxLength": 265, "pattern": "^conv_[a-zA-Z0-9_\\-]+$" },
        "participantA": { "type": "string", "minLength": 1, "maxLength": 128 },
        "participantB": { "type": "string", "minLength": 1, "maxLength": 128 },
        "talk2tmIdA": { "type": "string", "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "talk2tmIdB": { "type": "string", "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "displayNameA": { "type": "string", "minLength": 1, "maxLength": 30 },
        "displayNameB": { "type": "string", "minLength": 1, "maxLength": 30 },
        "matchedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["matched", "unmatched"] },
        "seenByA": { "type": "boolean" },
        "seenByB": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "chatStarted": { "type": "boolean" },
        "chatStartedAt": { "type": "string", "format": "date-time" },
        "unmatchedByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "unmatchedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "matchId", "conversationId", "participantA", "participantB",
        "talk2tmIdA", "talk2tmIdB", "displayNameA", "displayNameB",
        "matchedByUid", "status", "seenByA", "seenByB", "createdAt", "updatedAt"
      ]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "Bloqueio direto entre utilizadores que filtra descoberta, anula matches/likes e bloqueia envio de mensagens.",
      "type": "object",
      "properties": {
        "blockId": { "type": "string", "minLength": 3, "maxLength": 266, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "blockerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "blockedUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "blockerTalk2tmId": { "type": "string", "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "reason": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["blockId", "blockerUid", "blockedUid", "createdAt"]
    },
    "ModerationReport": {
      "title": "ModerationReport",
      "description": "Denúncia de perfil ou mensagem específica com prova textual congelada para moderação administrativa.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "minLength": 4, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reporterTalk2tmId": { "type": "string", "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "targetUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetTalk2tmId": { "type": "string", "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "targetDisplayName": { "type": "string", "maxLength": 30 },
        "sourceType": { "type": "string", "enum": ["dating_profile", "dating_match", "chat_message", "connection"] },
        "channelId": { "type": "string", "maxLength": 140 },
        "itemRefId": { "type": "string", "maxLength": 140 },
        "reason": { "type": "string", "enum": ["spam", "harassment", "fake_profile", "underage", "scam", "other"] },
        "details": { "type": "string", "maxLength": 300 },
        "evidenceSnapshot": { "type": "string", "minLength": 1, "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewedByUid": { "type": "string", "maxLength": 128 },
        "resolutionAction": { "type": "string", "enum": ["none", "account_suspended", "dismissed"] },
        "resolutionNote": { "type": "string", "maxLength": 200 }
      },
      "required": [
        "reportId", "reporterUid", "reporterTalk2tmId", "targetUid",
        "sourceType", "reason", "evidenceSnapshot", "status", "createdAt"
      ]
    },
    "UserRateLimit": {
      "title": "UserRateLimit",
      "description": "Estado anti-spam diário por UID para limitar likes, denúncias e convites no Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "dayKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "likeDayKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "likeCountToday": { "type": "integer" },
        "reportDayKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "reportCountToday": { "type": "integer" },
        "inviteDayKey": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "inviteCountToday": { "type": "integer" },
        "lastReportAtMs": { "type": "number" },
        "lastInviteAtMs": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid", "dayKey", "likeDayKey", "likeCountToday",
        "reportDayKey", "reportCountToday", "inviteDayKey", "inviteCountToday", "updatedAt"
      ]
    },
    "ReferralLink": {
      "title": "ReferralLink",
      "description": "Código único público de convite sem exposição de PII (telefone/e-mail/TM-ID).",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9]{6,12}$" },
        "referrerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "referrerDisplayName": { "type": "string", "minLength": 1, "maxLength": 30 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "referrerUid", "referrerDisplayName", "active", "createdAt"]
    },
    "ReferralStats": {
      "title": "ReferralStats",
      "description": "Contador privado do padrinho para partilhas de link de convite.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "referralCode": { "type": "string", "pattern": "^[A-Z0-9]{6,12}$" },
        "invitesSharedCount": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "referralCode", "invitesSharedCount", "updatedAt"]
    },
    "ReferralAttribution": {
      "title": "ReferralAttribution",
      "description": "Atribuição imutável de novo registo ao utilizador padrinho.",
      "type": "object",
      "properties": {
        "newUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "newTalk2tmId": { "type": "string", "pattern": "^TM-[A-Z0-9]{4}-[A-Z0-9]{4}$" },
        "referralCode": { "type": "string", "pattern": "^[A-Z0-9]{6,12}$" },
        "referrerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["newUid", "newTalk2tmId", "referralCode", "referrerUid", "createdAt"]
    },
    "GrowthTelemetry": {
      "title": "GrowthTelemetry",
      "description": "Sinal agregado mínimo de atividade semanal (WAU) e distribuição geográfica por cidade sem PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "lastActiveDay": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "city": { "type": ["string", "null"], "maxLength": 60 },
        "cityKey": { "type": ["string", "null"], "maxLength": 60 },
        "countryCode": { "type": ["string", "null"], "maxLength": 4 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "lastActiveAt", "lastActiveDay", "updatedAt"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Coleção de salas legadas Talk2TM limitadas a 2 participantes."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Coleção linear de mensagens legadas da sala."
    },
    "/users/{uid}": {
      "schema": "UserAccount",
      "description": "Metadados privados da conta do usuário autenticado."
    },
    "/userProfiles/{talk2tmId}": {
      "schema": "UserProfile",
      "description": "Índice público de perfis ativos para busca por Talk2TM ID."
    },
    "/usernames/{usernameLower}": {
      "schema": "UsernameDirectoryEntry",
      "description": "Índice único de nomes de utilizador sem listagem pública."
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Conversas bilaterais ativas entre exatamente dois participantes."
    },
    "/conversationInvites/{inviteId}": {
      "schema": "ConversationInvite",
      "description": "Convites de conexão bilateral entre usuários."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "ConversationMessage",
      "description": "Mensagens estritas vinculadas aos dois participantes da conversa."
    },
    "/datingProfiles/{profileUid}": {
      "schema": "DatingProfile",
      "description": "Perfis públicos adultos (+18) para descoberta finita e filtrada sem PII."
    },
    "/datingProfiles/{profileUid}/evaluations/{targetUid}": {
      "schema": "DatingEvaluation",
      "description": "Subcoleção privada do utilizador com avaliações diárias e exclusões."
    },
    "/datingLikes/{likeId}": {
      "schema": "DatingLike",
